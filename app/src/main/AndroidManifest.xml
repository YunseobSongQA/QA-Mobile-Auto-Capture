<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      API 30 이상은 권한 선언 없음. 네트워크 권한은 라이브러리가 끼워 넣지 못하게 명시적으로 제거한다
      (외부 전송 없음 보장, CI 에서도 APK 권한을 확인한다).
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!--
      API 26~29 전용(capture/projection). 이 버전에는 접근성 takeScreenshot(API 30)이 없어 화면 녹화로 찍는다.
      maxSdkVersion 때문에 API 30 이상에서는 이 권한들이 없다(지금과 같음).
    -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 런처와 IME 패키지를 무시 목록에 넣기 위한 조회만 선언한다. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.QACapture">

        <!-- 런처·접근성 설정의 "설정" 버튼(accessibility_service_config settingsActivity)이 여는 화면. 이름 고정. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.session.SessionActivity"
            android:exported="false" />

        <activity
            android:name=".ui.viewer.ImageViewerActivity"
            android:exported="false" />

        <!-- 클래스 이름을 바꾸면 덮어쓰기 설치 후 접근성 권한이 풀린다. 고정할 것. -->
        <service
            android:name=".capture.CaptureService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- API 26~29 화면 녹화: 기록 시작 때 동의 화면, 기록 중 포그라운드 서비스. API 30 이상은 꺼 둔다(values-v30/bools.xml). -->
        <activity
            android:name=".capture.projection.ProjectionConsentActivity"
            android:enabled="@bool/projection_capture"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".capture.projection.ProjectionService"
            android:enabled="@bool/projection_capture"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"
            tools:ignore="ForegroundServicePermission" />

        <!-- 알림창 빠른 설정 타일: 캡처 일시정지/재개. BIND_QUICK_SETTINGS_TILE 은 시스템만 가진 권한(앱이 요청하는 권한 아님). -->
        <service
            android:name=".capture.CaptureTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
    </application>
</manifest>
