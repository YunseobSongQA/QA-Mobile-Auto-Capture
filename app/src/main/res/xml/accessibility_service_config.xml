<?xml version="1.0" encoding="utf-8"?>
<!--
  FLAG_REQUEST_ACCESSIBILITY_BUTTON 을 요청하지 않으므로
  접근성 바로가기(음량 키 / 접근성 버튼)는 이 서비스를 켜고 끄는 동작을 한다.
  canRetrieveWindowContent 는 이벤트의 windowId 와 기록 시작 시 앞에 있는 창 확인에 필요하다.
  받는 이벤트: 창 전환(화면 진입), 스크롤, 토스트 알림.
  이벤트 종류는 CaptureService.CAPTURE_EVENT_TYPES 와 같아야 한다
  (캡처 일시정지 중에는 0, 디버그 로그 중에는 모든 이벤트로 서비스가 바꾼다).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeViewScrolled|typeNotificationStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagIncludeNotImportantViews"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/service_description"
    android:notificationTimeout="0"
    android:settingsActivity="com.qa.autocapture.MainActivity"
    android:summary="@string/service_summary" />
